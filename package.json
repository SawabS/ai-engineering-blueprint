{
  "name": "ai-engineering-blueprint",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive course on AI engineering, from the naked LLM to agent harnesses.",
  "scripts": {
    "build": "sh build.sh",
    "serve": "python3 -m http.server 4173",
